{
  "name": "lst-forecast",
  "version": "1.0.0",
  "description": "WebGIS giám sát & dự báo nhiệt độ bề mặt (LST) 168 phường/xã TP.HCM — Node.js + Express + PostgreSQL/PostGIS + Leaflet + Three.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "nap-du-lieu": "python database/etl/nap_du_lieu.py",
    "du-bao": "python -u database/etl/du_bao_lst.py"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1"
  }
}
