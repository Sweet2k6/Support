# Kết nối PostgreSQL/PostGIS
PGHOST=localhost
PGPORT=5432
PGDATABASE=webgis
PGUSER=postgres
PGPASSWORD=mat_khau_cua_ban
# Đặt true nếu CSDL yêu cầu SSL (máy chủ đám mây)
PGSSL=false

# Máy chủ web
PORT=3000

# ── Đăng nhập & phân quyền ──
# Khoá ký phiên đăng nhập (chuỗi ngẫu nhiên dài). Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=doi_chuoi_ngau_nhien_dai

# Quản trị viên đầu tiên: chỉ dùng khi CSDL chưa có tài khoản admin nào.
# Sau khi đăng nhập được, đổi mật khẩu trong trang Quản trị rồi xoá ADMIN_PASSWORD khỏi file này.
ADMIN_USER=admin
ADMIN_PASSWORD=doi_mat_khau_nay

# Cho phép người lạ tự đăng ký tài khoản "người dùng" (false = chỉ admin tạo tài khoản)
ALLOW_REGISTER=true
# Đặt true khi web chạy sau HTTPS để cookie chỉ gửi qua kết nối mã hoá
COOKIE_SECURE=false
